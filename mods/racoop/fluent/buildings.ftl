## Descriptions of the buildings that work differently in co-op (rules/buffs.yaml and rules/forces.yaml)
coop-actor-powr-description =
    Gives all your units and buildings +10% damage.
    Each one adds another 10%.
    Costs 1000 more for each one you own.

coop-actor-dome-description =
    Gives all your units and buildings +10% range.
    Each one adds another 10%.
    Costs 1000 more for each one you own.

coop-actor-atek-description =
    Unlocks your force's advanced units
    and support powers.

coop-actor-fix-description =
    Repairs vehicles for free.

coop-actor-afld-description =
    Produces planes, and rearms
    and repairs them for free.

coop-actor-hpad-description =
    Produces helicopters, and rearms
    and repairs them for free.

coop-actor-weap-air-description =
    Produces Mobile Flak.
