## Tech Center support powers (rules/powers.yaml)
coop-power-paratroopers-name = Paratroopers
coop-power-paratroopers-description = A Badger drops a squad of infantry
    at the selected location.

coop-power-flashfreeze-name = Flash Freeze
coop-power-flashfreeze-description = Slows every unit in a 5x5 area, friend or foe,
    to 60% speed for 20 seconds.

coop-power-strafingrun-name = Strafing Run
coop-power-strafingrun-description = Three Yaks strafe a 10-cell line through the target
    in the chosen direction. Deadly to infantry and light vehicles.
    Only hurts enemies.

coop-power-parabombs-name = Parabombs
coop-power-parabombs-description = A Badger drops parachuted bombs
    at the selected location.

coop-power-cruisershelling-name = Cruiser Shelling
coop-power-cruisershelling-description = Cruisers off the west coast fire 6 shells
    into a 4x4 area anywhere on the map.
